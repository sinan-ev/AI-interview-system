# Environment & App Settings
APP_NAME="AI Interview & Assessment Platform"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"
SECRET_KEY="replace-with-ultra-secure-random-secret-key-in-production"

# Database Configuration (PostgreSQL + pgvector)
# Use asyncpg for SQLAlchemy AsyncEngine
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/ai_interview_db"
# Sync URL used by Alembic migrations
SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_interview_db"
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# Redis & Celery
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# Security & Authentication
JWT_SECRET="replace-with-jwt-secret-key-minimum-32-chars-long"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI LLM Provider Configuration
# Supported providers: mock, openai, anthropic, google
LLM_PROVIDER="mock"
LLM_API_KEY="your-llm-api-key-here"
LLM_MODEL="gpt-4o"
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# Embeddings Configuration
# Supported providers: mock, openai, local
EMBEDDING_PROVIDER="mock"
EMBEDDING_API_KEY=""
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=1536

# Speech-to-Text (STT) Provider
# Supported providers: mock, whisper, deepgram, openai
STT_PROVIDER="mock"
STT_API_KEY=""
STT_MODEL="whisper-1"

# Storage & Upload Limits
MAX_FILE_SIZE_BYTES=10485760  # 10 MB
ALLOWED_FILE_EXTENSIONS=["pdf", "docx", "pptx", "txt", "md"]
ALLOWED_AUDIO_EXTENSIONS=["wav", "mp3", "m4a", "webm", "ogg"]
UPLOAD_DIR="./uploads"

# Rate Limiting (slowapi format)
RATE_LIMIT="100/minute"
AUTH_RATE_LIMIT="5/minute"
INTERVIEW_RATE_LIMIT="10/minute"

# CORS
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:5173", "http://127.0.0.1:3000"]
